# Copy to $TG_GUARD_HOME/.env (default ~/.local/share/tg-guard/.env) and chmod 600.
# Credentials from https://my.telegram.org -> API development tools.
TG_API_ID=
TG_API_HASH=

# Optional settings (defaults shown)
# TG_DOWNLOAD_DAYS=7                 # downloads are deleted after this many days
# TG_WHISPER_MODEL=large-v3-turbo    # any faster-whisper model: small, medium, ...
# TG_READ_DEVICE=tg-guard            # name under Telegram -> Settings -> Devices
# TG_DRAFT_DEVICE=tg-guard-drafts
# TG_SESSION=                        # session paths, without ".session"
# TG_DRAFT_SESSION=
# TG_DOWNLOADS=  TG_MODELS=  TG_DRAFTS_LOG=
